# ── GoldMoufDog — environment ─────────────────────────────────────
# Live metals feed (P05). Get a free key at https://metals.dev
# When set, the top ticker + hero + builder prices become genuinely
# live (USD/oz). The free tier is 100 requests/MONTH, so the app
# fetches at most once per 12h and caches in localStorage — reloads
# cost 0 calls. Leave blank to use the built-in simulated ticker.
# Copy this file to `.env.local` and paste your key (never commit it).
VITE_METALS_API_KEY=

# ── Shopify ───────────────────────────────────────────────────────
# Storefront token is public by design: it ships in the client bundle
# and can only read published products and write carts. Admin → Settings
# → Apps → Develop apps → your app → Storefront API access token.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2025-01

# Admin token — NEVER prefix with VITE_, or Vite inlines it into the
# browser bundle. Needs write_products + write_publications and is read
# only by scripts/shopify-import.mjs.
SHOPIFY_ADMIN_TOKEN=
